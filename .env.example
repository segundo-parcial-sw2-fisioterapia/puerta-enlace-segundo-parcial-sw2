# Servidor
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=<secreto-seguro-cambiar-en-produccion>
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# URLs de Microservicios Internos
# clinica expone REST en /api y GraphQL en /graphql
CLINICA_URL=http://localhost:3000/api
CLINICA_GRAPHQL_URL=http://localhost:3000/graphql
GESTION_ADMINISTRATIVA_URL=http://localhost:3001/graphql
BI_AUTOMATIZACION_URL=http://localhost:8000/api

# Rate Limiting (peticiones por ventana de tiempo)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
